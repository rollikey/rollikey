{
  "name": "@rollikey/sdk",
  "version": "0.1.0",
  "description": "Typed client for Rollikey: blast-radius gate, airlock and one-call revert for AI agent actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rollikey/rollikey.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://rollikey.com",
  "bugs": {
    "url": "https://github.com/rollikey/rollikey/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "safety",
    "rollback",
    "rollikey"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
