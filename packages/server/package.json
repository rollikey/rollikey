{
  "name": "@rollikey/mcp",
  "version": "0.1.0",
  "description": "Rollikey MCP proxy: blast-radius gate, staging airlock and deterministic revert for AI agent actions",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rollikey/rollikey.git",
    "directory": "packages/server"
  },
  "homepage": "https://rollikey.com",
  "bugs": {
    "url": "https://github.com/rollikey/rollikey/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "safety",
    "rollback",
    "rollikey"
  ],
  "bin": {
    "rollikey-mcp": "dist/mcp/stdio.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "dev": "tsx src/mcp/stdio.ts",
    "worker": "tsx src/scripts/airlock-worker.ts",
    "demo": "tsx src/scripts/demo.ts",
    "dashboard": "tsx src/dashboard/main.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "drill:5tool": "tsx src/scripts/five-tool-drill.ts",
    "check:stripe-hold": "tsx src/scripts/stripe-hold.ts",
    "start": "node dist/dashboard/main.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
