# --- Local Docker services (docker compose up -d) ---
DATABASE_URL=postgres://rollikey:rollikey_dev_password@localhost:5432/rollikey_db
REDIS_URL=redis://localhost:6379

# Mailpit SMTP (web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=rollikey-agent@rollikey.local

# Stripe TEST key only (sk_test_...). Live keys are refused by the prototype.
STRIPE_SECRET_KEY=

# LLM provider key for the agent driving Rollikey (unused by the proxy itself)
LLM_API_KEY=

# --- Rollikey gate / airlock tuning (defaults shown) ---
ROLLIKEY_MAX_ROWS=10
ROLLIKEY_MAX_AMOUNT_CENTS=100000
ROLLIKEY_AIRLOCK_SECONDS=60
ROLLIKEY_RUN_AIRLOCK_WORKER=true

# --- Phase 2B connectors ($0 local sandboxes by default) ---
# AWS S3 -> local MinIO (docker compose service "minio", console http://localhost:9001).
# Point S3_ENDPOINT at real AWS (and set real keys) only if you want live S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=rollikey-sandbox
S3_VAULT_BUCKET=rollikey-vault
# S3_ACCESS_KEY_ID=rollikey_minio              # defaults match docker-compose.yml
# S3_SECRET_ACCESS_KEY=rollikey_minio_password

# GitHub: unset GITHUB_TOKEN => built-in offline sandbox server on GITHUB_SANDBOX_PORT.
# GITHUB_TOKEN=
GITHUB_SANDBOX_PORT=4010
GITHUB_DEFAULT_REPO=rollikey-sandbox/demo

# Slack: unset => posts land in the local Slack inbox sink (shown in the dashboard).
# SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_URL=

# --- Phase 2C: Stripe auth-hold + optional Connect fee ---
# Fee taken ONLY when a Stripe auth-hold is captured (hosted Connect mode). 0 = no fee (default, self-hosted).
# Allowed: 0, or 25-50 (0.25%-0.50%). Needs ROLLIKEY_CONNECT_ACCOUNT. DB / S3 / GitHub / Slack / Email rollbacks are always free.
ROLLIKEY_CONNECT_FEE_BPS=0
# ROLLIKEY_CONNECT_ACCOUNT=acct_...

# --- Phase 3A: hosted pilot ---
# Contact link behind the dashboard/demo "Hosted pilot" button (https:// or mailto:).
# ROLLIKEY_PILOT_URL=
# Hosted only: bind address and public hostnames the dashboard accepts (it has no auth; protect it).
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_ALLOWED_HOSTS=my-pilot.up.railway.app
